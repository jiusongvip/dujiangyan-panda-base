# Cloudflare Pages headers.
# Hashed build assets and static images never change content -> cache 1 year.
# HTML keeps platform defaults so deploys appear immediately.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/rss.xml
  Cache-Control: public, max-age=3600
