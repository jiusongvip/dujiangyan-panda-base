---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  as?: "h1" | "h2" | "h3";
}

const { eyebrow, title, subtitle, as: Tag = "h2" } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && (
    <p class="text-xs font-medium tracking-wide text-accent-600 uppercase mb-3">{eyebrow}</p>
  )}
  <Tag class="text-3xl md:text-4xl font-bold text-warm-900 leading-tight">{title}</Tag>
  {subtitle && (
    <p class="mt-4 text-warm-600 leading-relaxed max-w-[65ch]">{subtitle}</p>
  )}
</div>
