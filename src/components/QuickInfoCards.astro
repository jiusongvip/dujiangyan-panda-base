---
const infos = [
  { label: "Opening Hours", value: "8:30 AM - 5:00 PM", note: "Daily, year-round" },
  { label: "Entrance Fee", value: "CNY 58", note: "Adult ticket" },
  { label: "Location", value: "Dujiangyan, Sichuan", note: "~60 km from Chengdu" },
  { label: "Best Season", value: "Mar - May, Sep - Nov", note: "Mild weather" },
];
---

<section class="max-w-7xl mx-auto px-4 mt-6 relative z-10">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    {infos.map((info) => (
      <div class="bg-white rounded-xl border border-warm-200 p-5 shadow-sm hover:shadow-md transition-shadow">
        <p class="text-xs font-medium tracking-wide text-warm-500 uppercase mb-1">{info.label}</p>
        <p class="text-lg font-semibold text-warm-900">{info.value}</p>
        <p class="text-sm text-warm-500 mt-0.5">{info.note}</p>
      </div>
    ))}
  </div>
</section>
