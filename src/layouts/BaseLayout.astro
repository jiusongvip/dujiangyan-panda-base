---
import "../styles/global.css";
import EmailLink from "../components/EmailLink.astro";
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, jsonLd } = Astro.props;

// Clean title: avoid duplicating brand name. If page title already contains
// "Dujiangyan", use it as-is; otherwise append the brand suffix.
const baseName = "Dujiangyan Panda Base";
const fullTitle = title.includes("Dujiangyan") ? title : `${title} | ${baseName}`;

// Canonical URL and page path for structured data
const canonicalUrl = Astro.url.pathname === "/"
  ? new URL("/", Astro.site).href.replace(/\/$/, "")
  : new URL(Astro.url.pathname, Astro.site).href;
const pagePath = Astro.url.pathname === "/" ? [] : Astro.url.pathname.replace(/\/$/, "").split("/").filter(Boolean);

// Default OG image if none provided
const defaultOgImage = new URL("/images/hero-panda-bamboo.webp", Astro.site).href;
const ogImageUrl = ogImage || defaultOgImage;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T96B7YRQZ3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-T96B7YRQZ3');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- LCP preload: only on the homepage, which has the hero carousel -->
    {Astro.url.pathname === "/" && (
      <link
        rel="preload"
        as="image"
        href="/images/hero-panda-bamboo-1280.webp"
        imagesrcset="/images/hero-panda-bamboo-480.webp 480w, /images/hero-panda-bamboo-768.webp 768w, /images/hero-panda-bamboo-960.webp 960w, /images/hero-panda-bamboo-1280.webp 1280w, /images/hero-panda-bamboo.webp 1920w"
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Dujiangyan Panda Base Guide" href="/rss.xml" />

    <!-- JSON-LD Structured Data: Organization + WebSite + BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "Dujiangyan Panda Base Guide",
          "url": Astro.site?.href,
          "description": "Independent travel guide for visiting and volunteering at Dujiangyan Panda Base near Chengdu, China.",
          "logo": new URL("/favicon.svg", Astro.site).href,
          "sameAs": [
            "https://panda.org.cn/en/",
            "https://en.wikipedia.org/wiki/China_Conservation_and_Research_Center_for_the_Giant_Panda",
          ],
        },
        {
          "@type": "WebSite",
          "name": "Dujiangyan Panda Base Guide",
          "url": Astro.site?.href,
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": `${Astro.site?.href}search?q={search_term_string}`
            },
            "query-input": "required name=search_term_string"
          }
        },
        ...(pagePath.length > 0 ? [{
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.site?.href },
            ...pagePath.map((seg, i) => ({
              "@type": "ListItem",
              "position": i + 2,
              "name": seg.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
              "item": new URL(`/${pagePath.slice(0, i + 1).join("/")}`, Astro.site).href,
            }))
          ]
        }] : []),
        ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-warm-50/85 backdrop-blur-md border-b border-warm-200/60">
      <nav class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" aria-label="Dujiangyan Panda Base Guide — Home" class="flex items-center gap-2.5 hover:opacity-90 transition-opacity">
          <span class="w-8 h-8 rounded-full bg-accent-100 flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600">
              <circle cx="12" cy="12" r="10"/><circle cx="12" cy="10" r="3"/><path d="M7 18c1.5-2 3-3 5-3s3.5 1 5 3"/><circle cx="8" cy="9" r="1"/><circle cx="16" cy="9" r="1"/>
            </svg>
          </span>
          <span class="hidden sm:inline font-display font-semibold text-warm-950 text-lg">Dujiangyan Panda Base</span>
        </a>
        <div class="flex items-center gap-7 text-[13px] font-medium tracking-wide">
          <a href="/#alternatives" class="text-amber-700 hover:text-amber-900 transition-colors font-semibold uppercase tracking-[0.08em]">Alternatives</a>
          <a href="/#volunteer" class="text-warm-700 hover:text-accent-600 transition-colors uppercase tracking-[0.08em]">Volunteer</a>
          <a href="/#tickets" class="text-warm-700 hover:text-accent-600 transition-colors uppercase tracking-[0.08em]">Tickets</a>
          <a href="/#getting-there" class="hidden md:inline text-warm-700 hover:text-accent-600 transition-colors uppercase tracking-[0.08em]">Getting There</a>
          <a href="/#faq" class="hidden lg:inline text-warm-700 hover:text-accent-600 transition-colors uppercase tracking-[0.08em]">FAQ</a>
        </div>
      </nav>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="bg-warm-950 text-warm-300">
      <div class="max-w-7xl mx-auto px-4 pt-14 pb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div>
            <p class="text-warm-100 font-display font-semibold text-lg mb-4">Dujiangyan Panda Base</p>
            <p class="text-sm text-warm-400 leading-relaxed">Your complete, independent guide to visiting, volunteering, and experiencing the pandas at Dujiangyan.</p>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.18em] text-warm-500 uppercase mb-4">Plan Your Visit</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/#alternatives" class="hover:text-amber-300 transition-colors">Alternatives (While Closed)</a></li>
              <li><a href="/#volunteer" class="hover:text-white transition-colors">Volunteer Program</a></li>
              <li><a href="/#tickets" class="hover:text-white transition-colors">Tickets & Pricing</a></li>
              <li><a href="/#getting-there" class="hover:text-white transition-colors">How to Get There</a></li>
              <li><a href="/#best-time" class="hover:text-white transition-colors">Best Time to Visit</a></li>
            </ul>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.18em] text-warm-500 uppercase mb-4">Compare</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/#comparison" class="hover:text-white transition-colors">vs Chengdu Base</a></li>
              <li><a href="/#nearby" class="hover:text-white transition-colors">Nearby Attractions</a></li>
              <li><a href="/#alternatives" class="hover:text-white transition-colors">Alternatives (While Closed)</a></li>
              <li><a href="/#faq" class="hover:text-white transition-colors">FAQ</a></li>
              <li><a href="/#stories" class="hover:text-white transition-colors">Volunteer Stories</a></li>
            </ul>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.18em] text-warm-500 uppercase mb-4">Contact & Legal</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/about/" class="hover:text-white transition-colors">About</a></li>
              <li><EmailLink label="Contact" class="hover:text-white transition-colors" /></li>
              <li><a href="/privacy/" class="hover:text-white transition-colors">Privacy Policy</a></li>
              <li><a href="/terms/" class="hover:text-white transition-colors">Terms of Use</a></li>
            </ul>
            <a href="https://panda.org.cn/en/" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm text-accent-300 hover:text-white transition-colors">
              Official operator: panda.org.cn
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="mt-12 pt-6 border-t border-warm-800 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-sm text-warm-500">
          <p>&copy; {new Date().getFullYear()} Dujiangyan Panda Base Guide. Not affiliated with the official base.</p>
          <p class="flex items-center gap-2 text-xs">
            <span class="text-amber-400">★</span> Rated 4.7/5 by 388 travelers on TripAdvisor
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
