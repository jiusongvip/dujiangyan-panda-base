---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/Faq.astro";

const items = [
  { q: "What is the difference between Dujiangyan Panda Base and Chengdu Panda Base?", a: "Dujiangyan is quieter, has fewer pandas (~20), and offers a hands-on volunteer program. Chengdu Research Base is much larger (~200 pandas), offers the famous panda nursery, and is more easily accessible by subway from downtown Chengdu. See our <a href='/dujiangyan-vs-chengdu-panda-base' class='text-accent-600 hover:text-accent-700 underline'>full comparison</a> for a detailed breakdown." },
  { q: "How much does the volunteer program cost?", a: "The volunteer program costs approximately CNY 700-900 per person, which includes the entrance fee, a uniform, gloves, lunch, and a certificate of participation. Check our <a href='/volunteer-program' class='text-accent-600 hover:text-accent-700 underline'>volunteer program page</a> for the full cost breakdown and what is included." },
  { q: "How do I get to Dujiangyan Panda Base from Chengdu?", a: "The fastest way is the high-speed train from Xipu Station to Dujiangyan Station (20-30 min), followed by a 15-minute taxi ride. Total journey takes about 1-1.5 hours. See <a href='/how-to-get-there' class='text-accent-600 hover:text-accent-700 underline'>all four transport options</a> with step-by-step directions and costs." },
  { q: "Can I hold a baby panda?", a: "Direct holding is generally no longer permitted under current conservation guidelines. However, the volunteer program allows you to sit next to a panda for a photo and get very close during feeding and enclosure care. Read our <a href='/blog/dujiangyan-panda-volunteer-experience' class='text-accent-600 hover:text-accent-700 underline'>volunteer experience</a> for a first-hand account." },
  { q: "When is the best time to visit?", a: "Spring (March-May) and autumn (September-November) offer the best weather and most active pandas. During summer, visit early morning. Winter has fewer crowds. Check our <a href='/best-time-to-visit' class='text-accent-600 hover:text-accent-700 underline'>season-by-season guide</a> for month-by-month details." },
  { q: "Do I need to book tickets in advance?", a: "General admission tickets can be purchased at the gate, but booking online is recommended during peak seasons. The volunteer program must be booked at least 1-2 weeks in advance. See our <a href='/tickets' class='text-accent-600 hover:text-accent-700 underline'>tickets guide</a> for prices and booking options." },
  { q: "Is the base suitable for children?", a: "Yes, the base is family-friendly and paths are stroller-friendly. The volunteer program has a minimum age of 12. Check our <a href='/visit-guide' class='text-accent-600 hover:text-accent-700 underline'>visit guide</a> for what to bring if you are visiting with kids." },
  { q: "What are the opening hours?", a: "The base is open daily from 8:30 AM to 5:00 PM, year-round including most Chinese holidays. We recommend arriving at opening time — pandas are most active in the morning. See our <a href='/visit-guide' class='text-accent-600 hover:text-accent-700 underline'>visit guide</a> for a suggested itinerary." },
];

const jsonLd = {
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a.replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<BaseLayout
  title="FAQ - Dujiangyan Panda Base Visiting & Volunteer Questions"
  description="Frequently asked questions about Dujiangyan Panda Base: tickets, volunteer program, getting there, best time to visit, and more."
  jsonLd={jsonLd}
>
  <section class="max-w-3xl mx-auto px-4 py-16 md:py-24">
    <p class="text-xs font-medium tracking-wide text-accent-600 uppercase mb-3">FAQ</p>
    <h1 class="text-3xl md:text-4xl font-bold text-warm-900 leading-tight tracking-tight">
      Frequently Asked Questions
    </h1>
    <p class="mt-4 text-warm-600 leading-relaxed">
      Quick answers to the most common questions about visiting and volunteering at Dujiangyan Panda Base.
    </p>
    <div class="mt-10">
      <Faq items={items} />
    </div>
  </section>
</BaseLayout>
