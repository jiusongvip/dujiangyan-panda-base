---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";

const posts = [
  {
    title: "How to Book the Dujiangyan Panda Volunteer Program",
    date: "July 2026",
    slug: "/blog/how-to-book-panda-volunteer",
    desc: "Step-by-step guide to securing your spot — reliable booking channels, required documents, how far in advance to plan, and red flags to watch for.",
  },
  {
    title: "Dujiangyan Panda Volunteer: My Honest Experience",
    date: "June 2026",
    slug: "/blog/dujiangyan-panda-volunteer-experience",
    desc: "What a day as a panda keeper really looks like. Cleaning enclosures, preparing bamboo, hand-feeding pandas, and the unforgettable moments.",
  },
];
---

<BaseLayout
  title="Dujiangyan Panda Base Blog - Volunteer Stories & Guides"
  description="Articles, first-hand stories, and practical guides about visiting and volunteering at Dujiangyan Panda Base near Chengdu."
>
  <section class="max-w-4xl mx-auto px-4 py-16 md:py-24">
    <SectionHeader eyebrow="Blog" title="Stories & Guides" subtitle="Tips, experiences, and in-depth guides about Dujiangyan Panda Base." as="h1" />
    <div class="mt-12 space-y-8">
      {posts.map((post) => (
        <a href={post.slug} class="group block p-6 rounded-xl border border-warm-200 hover:border-accent-200 hover:shadow-sm transition-all">
          <p class="text-xs text-warm-500">{post.date}</p>
          <h2 class="mt-1 text-lg font-semibold text-warm-900 group-hover:text-accent-600 transition-colors">{post.title}</h2>
          <p class="mt-2 text-sm text-warm-600 leading-relaxed">{post.desc}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
