---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Faq from "../../components/Faq.astro";

const faqItems = [
  { q: "How much does the volunteer program cost?", a: "The program typically costs around CNY 700-900 per person, which includes the donation fee, uniform, gloves, lunch, and a certificate. Prices may vary by season and booking channel." },
  { q: "What is the minimum age for volunteers?", a: "Most programs require volunteers to be at least 12 years old. Participants under 18 must be accompanied by a parent or guardian." },
  { q: "Do I need to speak Chinese?", a: "Basic English is usually sufficient. Many programs have English-speaking coordinators. Learning a few Chinese phrases can enhance your experience." },
  { q: "What should I wear?", a: "Wear comfortable clothes you don't mind getting dirty, closed-toe shoes, and bring sunscreen and insect repellent. The base provides a uniform or apron for volunteer activities." },
  { q: "How far in advance should I book?", a: "We recommend booking at least 1-2 weeks in advance. During peak seasons (summer, Chinese holidays), spots can fill up a month ahead." },
];

const jsonLd = {
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};
---

<BaseLayout
  title="Dujiangyan Panda Volunteer Program - Cost, Booking & Review"
  description="Everything about the Dujiangyan panda volunteer program: cost, how to book, what you'll do, age limits, and honest reviews from past volunteers."
  jsonLd={jsonLd}
>
  <section class="max-w-4xl mx-auto px-4 py-16 md:py-24">
    <p class="text-xs font-medium tracking-wide text-accent-600 uppercase mb-3">Volunteer Program</p>
    <h1 class="text-3xl md:text-5xl font-bold text-warm-900 leading-tight tracking-tight">
      Become a Panda Keeper for a Day
    </h1>
    <p class="mt-4 text-lg text-warm-600 leading-relaxed max-w-2xl">
      Spend a day caring for giant pandas at Dujiangyan. Clean enclosures, prepare bamboo, and get closer to pandas than most visitors ever will.
    </p>
    <p class="mt-2 text-xs text-warm-500">Last updated: July 2026</p>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <img
      src="/images/volunteer-feeding.webp"
      alt="Giant panda eating fresh bamboo up close at Dujiangyan"
      width="1200"
      height="600"
      class="rounded-2xl w-full aspect-[2/1] object-cover"
      loading="lazy"
    />
  </section>

  <!-- What You'll Do -->
  <section class="max-w-4xl mx-auto px-4 pb-16 md:pb-24">
    <SectionHeader title="What a typical day looks like" />
    <div class="mt-8 grid sm:grid-cols-2 gap-6">
      {[
        { step: "1", title: "Morning Briefing", desc: "Arrive at the base by 8:30 AM. Meet your coordinator, change into your volunteer uniform, and receive a safety orientation." },
        { step: "2", title: "Clean Enclosures", desc: "Help sweep and clean panda enclosures. This hands-on work gives you a unique behind-the-scenes look at panda care." },
        { step: "3", title: "Prepare Food", desc: "Wash and prepare bamboo, make panda cakes from a special grain mixture, and portion out apples and carrots." },
        { step: "4", title: "Feed the Pandas", desc: "The highlight: hand-feed pandas their favorite treats under staff supervision. Photos allowed during designated times." },
        { step: "5", title: "Observe & Learn", desc: "Watch panda behavior, learn about conservation efforts, and visit the nursery if cubs are present." },
        { step: "6", title: "Certificate", desc: "Receive your volunteer certificate and souvenir. Most programs finish around 3:00-4:00 PM." },
      ].map((item) => (
        <div class="flex gap-4 p-5 rounded-xl border border-warm-200">
          <span class="w-8 h-8 rounded-full bg-accent-100 flex items-center justify-center text-accent-700 font-semibold text-sm shrink-0">{item.step}</span>
          <div>
            <h3 class="font-semibold text-warm-900">{item.title}</h3>
            <p class="mt-1 text-sm text-warm-600 leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Cost & Booking -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <SectionHeader title="Cost and how to book" />
      <div class="mt-8 overflow-hidden rounded-xl border border-warm-200">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-warm-100">
              <th class="text-left px-5 py-3 font-medium text-warm-700">Item</th>
              <th class="text-left px-5 py-3 font-medium text-warm-700">Detail</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-warm-200">
            <tr><td class="px-5 py-3 font-medium text-warm-900">Program Fee</td><td class="px-5 py-3 text-warm-600">CNY 700-900 per person</td></tr>
            <tr class="bg-warm-50"><td class="px-5 py-3 font-medium text-warm-900">Includes</td><td class="px-5 py-3 text-warm-600">Entry fee, uniform, gloves, lunch, certificate</td></tr>
            <tr><td class="px-5 py-3 font-medium text-warm-900">Booking</td><td class="px-5 py-3 text-warm-600">Through official channels or authorized travel agencies</td></tr>
            <tr class="bg-warm-50"><td class="px-5 py-3 font-medium text-warm-900">Duration</td><td class="px-5 py-3 text-warm-600">Full day (approx. 8:30 AM - 3:30 PM)</td></tr>
            <tr><td class="px-5 py-3 font-medium text-warm-900">Age Limit</td><td class="px-5 py-3 text-warm-600">12+ (minors require guardian)</td></tr>
            <tr class="bg-warm-50"><td class="px-5 py-3 font-medium text-warm-900">Group Size</td><td class="px-5 py-3 text-warm-600">Small groups, typically 10-20 volunteers per day</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Who Can Volunteer -->
  <section class="max-w-4xl mx-auto px-4 py-16 md:py-24">
    <SectionHeader title="Who can volunteer" />
    <div class="mt-8 grid sm:grid-cols-3 gap-5">
      <div class="p-5 rounded-xl border border-warm-200">
        <h3 class="font-semibold text-warm-900">Health</h3>
        <p class="mt-2 text-sm text-warm-600 leading-relaxed">You should be in good general health. Anyone with a cold, flu, or infectious condition will not be allowed near the pandas to protect them.</p>
      </div>
      <div class="p-5 rounded-xl border border-warm-200">
        <h3 class="font-semibold text-warm-900">Age</h3>
        <p class="mt-2 text-sm text-warm-600 leading-relaxed">Minimum age is typically 12. There's no strict upper limit, but the work involves walking on hillsides and light physical activity.</p>
      </div>
      <div class="p-5 rounded-xl border border-warm-200">
        <h3 class="font-semibold text-warm-900">Documents</h3>
        <p class="mt-2 text-sm text-warm-600 leading-relaxed">Valid passport or ID required. Some programs may ask for a basic health declaration form.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 pb-24 md:pb-32">
    <SectionHeader eyebrow="FAQ" title="Common questions about volunteering" />
    <div class="mt-10"><Faq items={faqItems} /></div>
  </section>
</BaseLayout>
