---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";

const jsonLd = {
  "@type": "Article",
  "headline": "Dujiangyan Panda Base Closure Updates — Renovation Status & Alternatives",
  "description": "Dujiangyan Panda Base (都江堰中华大熊猫苑) closed on April 23, 2026 for renovations. Track reopening updates and find the best alternative panda experiences.",
  "datePublished": "2026-07-31",
  "dateModified": "2026-07-31",
  "author": {
    "@type": "Organization",
    "name": "Dujiangyan Panda Base Guide",
  },
};
---

<BaseLayout
  title="Closure Updates — Dujiangyan Panda Base Renovation Status"
  description="Dujiangyan Panda Base closed April 23, 2026 for facility upgrades. Track the latest reopening updates, official announcements, and recommended alternative panda bases."
  jsonLd={jsonLd}
>
  <section class="max-w-4xl mx-auto px-4 py-16 md:py-24">
    <p class="text-xs font-medium tracking-wide text-amber-600 uppercase mb-3">Important Update</p>
    <h1 class="text-3xl md:text-5xl font-bold text-warm-900 leading-tight tracking-tight">
      Dujiangyan Panda Base Is Closed for Renovation
    </h1>
    <p class="mt-4 text-lg text-warm-600 leading-relaxed max-w-2xl">
      The base closed on April 23, 2026 for facility upgrades. Here is everything you need to know, plus the best alternatives for your panda experience.
    </p>
    <p class="mt-2 text-xs text-warm-500">Last updated: July 31, 2026</p>
  </section>

  <!-- Official Announcement -->
  <section class="max-w-4xl mx-auto px-4 pb-12">
    <div class="p-6 rounded-xl bg-amber-50 border border-amber-200">
      <h2 class="text-lg font-semibold text-amber-900 mb-3">Official Closure Announcement</h2>
      <div class="space-y-3 text-sm text-amber-800 leading-relaxed">
        <p>
          On April 15, 2026, the China Conservation and Research Center for the Giant Panda (中国大熊猫保护研究中心) issued an official announcement:
        </p>
        <blockquote class="border-l-2 border-amber-300 pl-4 italic text-amber-700">
          "To improve park facilities, the Dujiangyan Base of the China Conservation and Research Center for the Giant Panda (都江堰中华大熊猫苑) will close starting April 23, 2026, to begin upgrade and renovation preparations. The reopening date will be announced separately."
        </blockquote>
        <p>
          The announcement was reported by <strong>Xinhua News Agency</strong>, <strong>China National Radio (CNR)</strong>, and other official media outlets on April 16, 2026.
        </p>
      </div>
    </div>
  </section>

  <!-- What We Know -->
  <section class="max-w-4xl mx-auto px-4 pb-12">
    <SectionHeader title="What we know so far" />
    <div class="mt-6 space-y-4 text-warm-700 leading-relaxed">
      <div class="flex items-start gap-3">
        <span class="w-5 h-5 rounded-full bg-green-100 flex items-center justify-center mt-0.5 shrink-0">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-green-600"><path d="M20 6L9 17l-5-5"/></svg>
        </span>
        <div>
          <p class="font-medium text-warm-900">Closure date</p>
          <p class="text-sm">April 23, 2026 — confirmed by official announcement</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <span class="w-5 h-5 rounded-full bg-green-100 flex items-center justify-center mt-0.5 shrink-0">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-green-600"><path d="M20 6L9 17l-5-5"/></svg>
        </span>
        <div>
          <p class="font-medium text-warm-900">Reason</p>
          <p class="text-sm">Facility upgrades and renovation preparation (完善园区配套设施，提升改造准备)</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <span class="w-5 h-5 rounded-full bg-yellow-100 flex items-center justify-center mt-0.5 shrink-0">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-yellow-600"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
        </span>
        <div>
          <p class="font-medium text-warm-900">Reopening date</p>
          <p class="text-sm">Not yet announced. The official statement says it will be "announced at a later time" (具体开园时间另行通知).</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <span class="w-5 h-5 rounded-full bg-green-100 flex items-center justify-center mt-0.5 shrink-0">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-green-600"><path d="M20 6L9 17l-5-5"/></svg>
        </span>
        <div>
          <p class="font-medium text-warm-900">Volunteer program</p>
          <p class="text-sm">Suspended along with the base closure. Not available during renovation.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <span class="w-5 h-5 rounded-full bg-green-100 flex items-center justify-center mt-0.5 shrink-0">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-green-600"><path d="M20 6L9 17l-5-5"/></svg>
        </span>
        <div>
          <p class="font-medium text-warm-900">About the base</p>
          <p class="text-sm">Built in 2013, the base spans 760 mu (~50.7 hectares). It serves as China's primary panda disease prevention and control center, panda rescue facility, and home to the world's only dedicated elderly panda care facility (大熊猫养老院) for pandas aged 26+.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Source References -->
  <section class="max-w-4xl mx-auto px-4 pb-12">
    <SectionHeader title="Official sources" />
    <div class="mt-6 space-y-2 text-sm text-warm-600">
      <p>• <a href="https://www.cnr.cn/newscenter/native/gd/kx/20260416/t20260416_527586518.shtml" target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:text-accent-700 underline">China National Radio (CNR) — April 16, 2026</a></p>
      <p>• <a href="http://www.ce.cn/xwzx/gnsz/gdxw/202604/t20260416_2907240.shtml" target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:text-accent-700 underline">China Economic Net (Xinhua reprint) — April 16, 2026</a></p>
      <p>• <a href="http://cd.bendibao.com/tour/2026415/207031.shtm" target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:text-accent-700 underline">Chengdu Bendibao — Official Announcement Full Text</a></p>
      <p>• <a href="https://www.gmw.cn/" target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:text-accent-700 underline">Guangming Daily — April 16, 2026</a></p>
    </div>
  </section>

  <!-- Alternatives -->
  <section id="alternatives" class="bg-accent-50 py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <SectionHeader title="Where to see pandas instead" subtitle="While Dujiangyan is closed, here are the best alternatives for your panda experience, from closest to furthest." />
      <div class="mt-10 space-y-6">
        <div class="p-6 rounded-xl bg-white border border-accent-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold">CLOSEST</span>
            <span class="px-2 py-0.5 rounded-full bg-accent-100 text-accent-700 text-xs font-semibold">RECOMMENDED</span>
          </div>
          <h3 class="text-lg font-semibold text-warm-900">Dujiangyan Panda Valley (熊猫谷)</h3>
          <p class="mt-1 text-sm text-warm-600">~17 km from the closed base, ~65 km from Chengdu. Part of the Chengdu Research Base system but focused on wild training and semi-wild release. Home to ~12 giant pandas and ~20 red pandas in a natural valley setting. Red pandas roam freely and may walk right past you on the boardwalks.</p>
          <div class="mt-3 grid sm:grid-cols-3 gap-3 text-xs">
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Tickets</span><br/><span class="font-semibold text-warm-900">CNY 55</span></div>
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Hours</span><br/><span class="font-semibold text-warm-900">7:30 AM - 5:30 PM</span></div>
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Transit</span><br/><span class="font-semibold text-warm-900">Train to Lidui Park + taxi</span></div>
          </div>
          <p class="mt-2 text-xs text-warm-500">Note: Panda Valley does NOT offer a volunteer program.</p>
        </div>

        <div class="p-6 rounded-xl bg-white border border-warm-200">
          <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold">VOLUNTEER AVAILABLE</span>
          <h3 class="text-lg font-semibold text-warm-900 mt-2">Wolong Giant Panda Nature Reserve (卧龙)</h3>
          <p class="mt-1 text-sm text-warm-600">~120 km from Chengdu (2-2.5 hours). The largest panda reserve with the most natural setting. Offers a full volunteer program (similar to Dujiangyan's). Home to Shenshuping Base with ~50 pandas. Best for an immersive, multi-day experience in the mountains.</p>
          <div class="mt-3 grid sm:grid-cols-3 gap-3 text-xs">
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Tickets</span><br/><span class="font-semibold text-warm-900">CNY 90</span></div>
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Volunteer</span><br/><span class="font-semibold text-warm-900">CNY 700-900</span></div>
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Transit</span><br/><span class="font-semibold text-warm-900">Bus from Chengdu</span></div>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-white border border-warm-200">
          <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold">VOLUNTEER AVAILABLE</span>
          <h3 class="text-lg font-semibold text-warm-900 mt-2">Bifengxia Panda Base (碧峰峡)</h3>
          <p class="mt-1 text-sm text-warm-600">~160 km from Chengdu (2.5 hours), near Ya'an. One of three bases offering the official panda keeper volunteer program. Home to ~80 pandas in a scenic gorge setting. A good choice if you want the full volunteer experience with fewer crowds than Wolong.</p>
          <div class="mt-3 grid sm:grid-cols-3 gap-3 text-xs">
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Tickets</span><br/><span class="font-semibold text-warm-900">CNY 118</span></div>
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Volunteer</span><br/><span class="font-semibold text-warm-900">CNY 700-900</span></div>
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Transit</span><br/><span class="font-semibold text-warm-900">Bus from Chengdu</span></div>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-white border border-warm-200">
          <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 text-xs font-semibold">LARGEST</span>
          <h3 class="text-lg font-semibold text-warm-900 mt-2">Chengdu Research Base of Giant Panda Breeding (成都大熊猫繁育研究基地)</h3>
          <p class="mt-1 text-sm text-warm-600">~10 km from downtown Chengdu. The most famous panda base with ~200 pandas, a panda nursery, and excellent museum facilities. Easily accessible by subway (Metro Line 3). Very crowded — arrive before 8 AM. No volunteer program, but the best place to see baby pandas.</p>
          <div class="mt-3 grid sm:grid-cols-3 gap-3 text-xs">
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Tickets</span><br/><span class="font-semibold text-warm-900">CNY 55</span></div>
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Hours</span><br/><span class="font-semibold text-warm-900">7:30 AM - 6:00 PM</span></div>
            <div class="bg-warm-50 rounded-lg p-2.5"><span class="text-warm-500">Transit</span><br/><span class="font-semibold text-warm-900">Metro Line 3</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="max-w-4xl mx-auto px-4 py-16 md:py-24">
    <SectionHeader title="Quick comparison of alternatives" />
    <div class="mt-8 overflow-hidden rounded-xl border border-warm-200 bg-white">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-warm-100">
            <th class="text-left px-4 py-3 font-medium text-warm-700">Base</th>
            <th class="text-left px-4 py-3 font-medium text-warm-700">Pandas</th>
            <th class="text-left px-4 py-3 font-medium text-warm-700">Volunteer</th>
            <th class="text-left px-4 py-3 font-medium text-warm-700">Distance</th>
            <th class="text-left px-4 py-3 font-medium text-warm-700">Best For</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-warm-200">
          <tr><td class="px-4 py-3 font-medium text-warm-900">Panda Valley</td><td class="px-4 py-3 text-warm-600">~12</td><td class="px-4 py-3 text-warm-600">No</td><td class="px-4 py-3 text-warm-600">65 km</td><td class="px-4 py-3 text-warm-600">Natural setting, red pandas</td></tr>
          <tr class="bg-warm-50"><td class="px-4 py-3 font-medium text-warm-900">Wolong</td><td class="px-4 py-3 text-warm-600">~50</td><td class="px-4 py-3 text-accent-600 font-medium">Yes</td><td class="px-4 py-3 text-warm-600">120 km</td><td class="px-4 py-3 text-warm-600">Immersive mountain experience</td></tr>
          <tr><td class="px-4 py-3 font-medium text-warm-900">Bifengxia</td><td class="px-4 py-3 text-warm-600">~80</td><td class="px-4 py-3 text-accent-600 font-medium">Yes</td><td class="px-4 py-3 text-warm-600">160 km</td><td class="px-4 py-3 text-warm-600">Full volunteer, scenic gorge</td></tr>
          <tr class="bg-warm-50"><td class="px-4 py-3 font-medium text-warm-900">Chengdu Base</td><td class="px-4 py-3 text-warm-600">~200</td><td class="px-4 py-3 text-warm-600">No</td><td class="px-4 py-3 text-warm-600">10 km</td><td class="px-4 py-3 text-warm-600">Baby pandas, easy access</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Stay Updated -->
  <section class="bg-warm-900 py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white">We are tracking the reopening</h2>
      <p class="mt-3 text-warm-300 max-w-lg mx-auto">
        This page will be updated as soon as the official reopening date is announced. We monitor official channels daily.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-warm-800 font-medium text-sm hover:bg-warm-100 transition-colors">
          Back to Home
        </a>
        <a href="/faq" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-warm-500 text-white font-medium text-sm hover:bg-warm-800 transition-colors">
          FAQ
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
