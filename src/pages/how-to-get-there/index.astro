---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
---

<BaseLayout
  title="How to Get to Dujiangyan Panda Base - From Chengdu & More"
  description="Step-by-step guide to reaching Dujiangyan Panda Base from Chengdu by train, bus, taxi, or tour. With maps, costs, and travel times."
>
  <section class="max-w-4xl mx-auto px-4 py-16 md:py-24">
    <p class="text-xs font-medium tracking-wide text-accent-600 uppercase mb-3">Getting There</p>
    <h1 class="text-3xl md:text-5xl font-bold text-warm-900 leading-tight tracking-tight">
      How to Get to Dujiangyan Panda Base
    </h1>
    <p class="mt-4 text-lg text-warm-600 leading-relaxed max-w-2xl">
      Four ways to reach the base from Chengdu. The high-speed train is the fastest and most convenient option.
    </p>
    <p class="mt-2 text-xs text-warm-500">Last updated: July 2026</p>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16 md:pb-24">
    <div class="space-y-10">
      {[
        {
          method: "High-Speed Train",
          time: "20-30 min train + 15 min taxi",
          cost: "CNY 10-15 train + CNY 20-30 taxi",
          icon: "M5 12h14M12 5l7 7-7 7",
          steps: [
            "Take Chengdu Metro Line 2 to Xipu Station (犀浦站)",
            "Transfer to the high-speed train to Dujiangyan Station (都江堰站)",
            "Trains run every 15-30 minutes from early morning to evening",
            "From Dujiangyan Station, take a taxi (15 min) to the Panda Base. Trains are part of the China high-speed rail network.",
          ],
        },
        {
          method: "Bus",
          time: "1.5-2 hours",
          cost: "CNY 20-30",
          icon: "M12 5v14M5 12h14",
          steps: [
            "From Chengdu Chadianzi Bus Station (茶店子客运站)",
            "Direct buses to Dujiangyan City Bus Station",
            "From the bus station, take a local taxi or bus to the base",
            "Less frequent than trains, check the schedule in advance",
          ],
        },
        {
          method: "Taxi / Ride-Hailing",
          time: "1-1.5 hours",
          cost: "CNY 150-250",
          icon: "M12 2L4 12l8 10 8-10z",
          steps: [
            "Use Didi (Chinese Uber) or hail a taxi from anywhere in Chengdu",
            "Show the driver: 都江堰熊猫基地 (Dujiangyan Panda Base)",
            "Most convenient door-to-door, especially with luggage",
            "Confirm the price or use the meter before departure",
          ],
        },
        {
          method: "Organized Tour",
          time: "Full day",
          cost: "CNY 300-600",
          icon: "M12 2a10 10 0 100 20 10 10 0 000-20z",
          steps: [
            "Book through Ctrip, Klook, or local travel agencies",
            "Includes hotel pickup, transport, and sometimes a guide",
            "Often combined with Dujiangyan Irrigation System visit",
            "Best for first-time visitors who want a hassle-free experience",
          ],
        },
      ].map((item) => (
        <div class="p-6 rounded-xl border border-warm-200 bg-white">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-accent-50 flex items-center justify-center shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d={item.icon}/></svg>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-baseline gap-3">
                <h3 class="font-semibold text-warm-900 text-lg">{item.method}</h3>
                <span class="text-xs text-warm-500">{item.time}</span>
                <span class="text-xs font-medium text-accent-600">{item.cost}</span>
              </div>
              <ol class="mt-3 space-y-1.5">
                {item.steps.map((s, i) => (
                  <li class="flex items-start gap-2 text-sm text-warm-600">
                    <span class="text-accent-500 font-medium">{i + 1}.</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-24">
    <div class="p-6 rounded-xl bg-accent-50 border border-accent-200">
      <h2 class="font-semibold text-warm-900 mb-2">Useful links</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="https://www.trip.com/trains/china/" target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:text-accent-700 underline">China high-speed rail schedules (Trip.com)</a> — check train times and book tickets online</li>
        <li><a href="https://en.wikipedia.org/wiki/Chengdu_Chadianzi_Bus_Station" target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:text-accent-700 underline">Chengdu Chadianzi Bus Station</a> — location and route information</li>
      </ul>
    </div>
  </section>
</BaseLayout>
