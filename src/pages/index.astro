---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuickInfoCards from "../components/QuickInfoCards.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ContentCard from "../components/ContentCard.astro";
import Faq from "../components/Faq.astro";

const faqItems = [
  {
    q: "What is the difference between Dujiangyan Panda Base and Chengdu Panda Base?",
    a: "Dujiangyan Panda Base is quieter and less crowded than the Chengdu Research Base. It offers more intimate panda encounters, including volunteer programs where you can help clean enclosures and prepare food. Chengdu Base is larger with more pandas overall and easier access from the city center.",
  },
  {
    q: "How do I book the volunteer program?",
    a: "The volunteer program typically needs to be booked in advance through official channels or authorized travel agencies. Spaces are limited, especially during peak seasons. You'll need to provide your passport details and health information. We recommend booking at least 1-2 weeks ahead.",
  },
  {
    q: "How long does it take to get there from Chengdu?",
    a: "By high-speed train from Chengdu's Xipu Station to Dujiangyan Station takes about 20-30 minutes, followed by a short taxi ride to the base. Total journey time is roughly 1-1.5 hours depending on connections.",
  },
  {
    q: "Can I hold a panda at Dujiangyan Panda Base?",
    a: "Under the volunteer program, you may have the opportunity to sit next to a panda for a photo, but direct holding is no longer permitted under current conservation regulations. The experience still allows very close interaction during feeding and enclosure care.",
  },
  {
    q: "Is it suitable for children?",
    a: "Yes! The base is family-friendly. The volunteer program typically has a minimum age of 12, but general visitors of all ages are welcome. The paths are well-maintained and stroller-friendly.",
  },
];

const jsonLd = {
  "@type": "TouristAttraction",
  "name": "Dujiangyan Panda Base",
  "description": "A quieter, more intimate panda experience near Chengdu, offering volunteer programs, close viewing areas, and a scenic hillside setting with approximately 20 pandas.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Dujiangyan",
    "addressRegion": "Sichuan",
    "addressCountry": "CN",
  },
  "openingHours": "Mo-Su 08:30-17:00",
  "priceRange": "CNY 58",
  "publicAccess": true,
  "touristType": ["Nature lovers", "Families", "Volunteers"],
};

const faqLd = {
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};

// Combine into @graph — BaseLayout will merge them with Organization/WebSite/BreadcrumbList
const combinedLd = [jsonLd, faqLd];
---

<BaseLayout
  title="Dujiangyan Panda Base - Volunteer, Tickets & Visit Guide"
  description="Complete guide to Dujiangyan Panda Base near Chengdu. Volunteer programs, ticket prices, transport options, best seasons to visit, and insider tips."
  jsonLd={combinedLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-accent-950/60 via-accent-950/30 to-transparent z-10" />
    <div class="absolute inset-0">
      <img
        src="/images/hero-panda-bamboo.webp"
        alt="Giant panda eating bamboo in natural habitat"
        width="1920"
        height="1080"
        class="w-full h-full object-cover"
        loading="eager"
      />
    </div>
    <div class="relative z-20 max-w-7xl mx-auto px-4 min-h-[85dvh] flex flex-col justify-center">
      <div class="max-w-2xl">
        <p class="text-accent-200 text-sm font-medium tracking-wide uppercase mb-4">Dujiangyan, Sichuan, China</p>
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight tracking-tight">
          Meet the Pandas at Dujiangyan
        </h1>
        <p class="mt-5 text-lg md:text-xl text-warm-200 leading-relaxed max-w-xl">
          A quieter, more intimate panda experience just 60 km from Chengdu. Volunteer, visit, and connect with China's most beloved animal.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/volunteer-program" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent-500 text-white font-medium text-sm hover:bg-accent-600 transition-colors">
            Volunteer Program
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/visit-guide" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 text-white font-medium text-sm hover:bg-white/10 transition-colors">
            Visit Guide
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Info Cards -->
  <QuickInfoCards />

  <!-- Why Dujiangyan -->
  <section class="max-w-7xl mx-auto px-4 py-24 md:py-32">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div>
        <SectionHeader
          eyebrow="Why Dujiangyan"
          title="A more personal panda experience"
          subtitle="Unlike the busy Chengdu Research Base, Dujiangyan Panda Base offers a tranquil setting where you can observe pandas in a natural hillside environment. The smaller crowds and closer viewing areas make every moment feel special."
        />
        <ul class="mt-8 space-y-4">
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-100 flex items-center justify-center mt-0.5 shrink-0">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-warm-700">Fewer visitors, more time to watch the pandas</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-100 flex items-center justify-center mt-0.5 shrink-0">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-warm-700">Hands-on volunteer program -- help care for pandas</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-100 flex items-center justify-center mt-0.5 shrink-0">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-warm-700">Set against the scenic hills of Dujiangyan, near the UNESCO irrigation system</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-100 flex items-center justify-center mt-0.5 shrink-0">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-warm-700">Easy day trip from Chengdu via high-speed train</span>
          </li>
        </ul>
      </div>
      <div class="relative">
        <img
          src="/images/panda-forest.webp"
          alt="Giant panda walking through a lush green forest"
          width="800"
          height="1000"
          class="rounded-2xl w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="absolute -bottom-4 -left-4 bg-accent-500 text-white rounded-xl px-5 py-3 shadow-lg">
          <p class="text-2xl font-bold">20+</p>
          <p class="text-xs text-accent-100">Pandas at the base</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Explore Sections -->
  <section class="bg-white py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeader
        eyebrow="Plan Your Visit"
        title="Everything you need to know"
        subtitle="From volunteer signups to getting there, we've covered every detail of your Dujiangyan panda adventure."
      />
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <ContentCard
          href="/volunteer-program"
          title="Volunteer Program"
          description="Spend a day as a panda keeper. Learn about costs, booking, age limits, and what a typical volunteer day looks like."
        />
        <ContentCard
          href="/tickets"
          title="Tickets & Pricing"
          description="Entrance fees, where to buy tickets, discount options, and tips for avoiding the queues."
        />
        <ContentCard
          href="/how-to-get-there"
          title="How to Get There"
          description="Step-by-step directions from Chengdu by train, bus, taxi, or organized tour. Maps and travel times included."
        />
        <ContentCard
          href="/dujiangyan-vs-chengdu-panda-base"
          title="Dujiangyan vs Chengdu"
          description="Compare the two bases side by side so you can decide which one fits your itinerary best."
        />
        <ContentCard
          href="/best-time-to-visit"
          title="Best Time to Visit"
          description="Season-by-season guide to weather, crowds, panda activity, and what to expect each month."
        />
        <ContentCard
          href="/nearby-attractions"
          title="Nearby Attractions"
          description="Combine your visit with the Dujiangyan Irrigation System, Mount Qingcheng, and other UNESCO sites nearby."
        />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-accent-900 py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight">Ready to meet the pandas?</h2>
      <p class="mt-4 text-accent-200 max-w-lg mx-auto">Start planning your Dujiangyan panda adventure today. The pandas are waiting.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/visit-guide" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-accent-800 font-medium text-sm hover:bg-accent-50 transition-colors">
          Read the Full Guide
        </a>
        <a href="/volunteer-program" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-accent-400 text-white font-medium text-sm hover:bg-accent-800 transition-colors">
          Volunteer Program
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 py-24 md:py-32">
    <SectionHeader
      eyebrow="FAQ"
      title="Frequently asked questions"
    />
    <div class="mt-10">
      <Faq items={faqItems} />
    </div>
  </section>
</BaseLayout>
