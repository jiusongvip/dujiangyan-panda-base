---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuickInfoCards from "../components/QuickInfoCards.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ContentCard from "../components/ContentCard.astro";
import Faq from "../components/Faq.astro";

const faqItems = [
  {
    q: "Is Dujiangyan Panda Base currently open?",
    a: "No. Dujiangyan Panda Base (都江堰中华大熊猫苑) closed on April 23, 2026 for facility upgrades and renovation. The reopening date has not been announced. See our closure updates page for the latest information and recommended alternatives.",
  },
  {
    q: "What is the difference between Dujiangyan Panda Base and Chengdu Panda Base?",
    a: "Dujiangyan Panda Base is quieter and less crowded than the Chengdu Research Base. It offers more intimate panda encounters, including volunteer programs where you can help clean enclosures and prepare food. Chengdu Base is larger with more pandas overall and easier access from the city center. Note: Dujiangyan is currently closed for renovations.",
  },
  {
    q: "How do I book the volunteer program?",
    a: "The volunteer program typically needs to be booked in advance through official channels or authorized travel agencies. Spaces are limited, especially during peak seasons. IMPORTANT: The Dujiangyan base is currently closed. See our closure updates page for alternative volunteer programs at Panda Valley, Wolong, or Bifengxia.",
  },
  {
    q: "How long does it take to get there from Chengdu?",
    a: "By high-speed train from Chengdu's Xipu Station to Dujiangyan Station takes about 20-30 minutes, followed by a short taxi ride to the base. Total journey time is roughly 1-1.5 hours depending on connections. Note: the base is currently closed — check our closure updates page before planning your trip.",
  },
  {
    q: "Can I hold a panda at Dujiangyan Panda Base?",
    a: "Under normal operations, the volunteer program may allow you to sit next to a panda for a photo, but direct holding is no longer permitted under current conservation regulations. The base is currently closed for renovations — check alternative bases for panda interaction programs.",
  },
  {
    q: "Is it suitable for children?",
    a: "Yes! Under normal operations, the base is family-friendly. The volunteer program typically has a minimum age of 12, but general visitors of all ages are welcome. The paths are well-maintained and stroller-friendly. Currently the base is closed — see our alternatives guide for family-friendly panda experiences.",
  },
];

const jsonLd = {
  "@type": "TouristAttraction",
  "name": "Dujiangyan Panda Base",
  "description": "A quieter, more intimate panda experience near Chengdu, offering volunteer programs, close viewing areas, and a scenic hillside setting with approximately 20 pandas.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Dujiangyan",
    "addressRegion": "Sichuan",
    "addressCountry": "CN",
  },
  "openingHours": "Mo-Su 08:30-17:00",
  "priceRange": "CNY 58",
  "publicAccess": true,
  "touristType": ["Nature lovers", "Families", "Volunteers"],
};

const faqLd = {
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};

// Combine into @graph — BaseLayout will merge them with Organization/WebSite/BreadcrumbList
const combinedLd = [jsonLd, faqLd];
---

<BaseLayout
  title="Dujiangyan Panda Base - Volunteer, Tickets & Visit Guide"
  description="Complete guide to Dujiangyan Panda Base near Chengdu. Volunteer programs, ticket prices, transport options, best seasons to visit, and insider tips."
  jsonLd={combinedLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-accent-950/60 via-accent-950/30 to-transparent z-10" />
    <div class="absolute inset-0">
      <img
        src="/images/hero-panda-bamboo.webp"
        alt="Giant panda eating bamboo in natural habitat"
        width="1920"
        height="1080"
        class="w-full h-full object-cover"
        loading="eager"
      />
    </div>
    <div class="relative z-20 max-w-7xl mx-auto px-4 min-h-[85dvh] flex flex-col justify-center">
      <div class="max-w-2xl">
        <p class="text-accent-200 text-sm font-medium tracking-wide uppercase mb-4">Dujiangyan, Sichuan, China</p>
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight tracking-tight">
          Meet the Pandas at Dujiangyan
        </h1>
        <p class="mt-5 text-lg md:text-xl text-warm-200 leading-relaxed max-w-xl">
          A quieter, more intimate panda experience just 60 km from Chengdu. Volunteer, visit, and connect with China's most beloved animal.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/volunteer-program" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent-500 text-white font-medium text-sm hover:bg-accent-600 transition-colors">
            Volunteer Program
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/visit-guide" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/30 text-white font-medium text-sm hover:bg-white/10 transition-colors">
            Visit Guide
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Closure Notice Banner -->
  <section class="bg-amber-50 border-b border-amber-200">
    <div class="max-w-7xl mx-auto px-4 py-4">
      <div class="flex flex-wrap items-start gap-3 md:items-center">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500 text-white text-xs font-semibold shrink-0">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          CLOSED
        </span>
        <div class="flex-1 min-w-0">
          <p class="text-sm md:text-base text-amber-900 font-medium">
            Dujiangyan Panda Base (中华大熊猫苑) is currently <strong>closed for renovations</strong> since April 23, 2026. Reopening date has not been announced.
          </p>
          <p class="text-xs md:text-sm text-amber-700 mt-0.5">
            <a href="/closure-updates" class="underline hover:text-amber-900 font-medium">Read the closure details</a> — or see our 
            <a href="/closure-updates#alternatives" class="underline hover:text-amber-900 font-medium">recommended alternatives</a> including Panda Valley, Wolong, and Bifengxia.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Info Cards -->
  <QuickInfoCards />

  <!-- 30-Second Verdict -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-16">
    <div class="grid md:grid-cols-3 gap-5">
      <div class="p-6 rounded-xl bg-green-50 border border-green-200">
        <p class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">Best for</p>
        <p class="text-xl font-bold text-green-900">Volunteers & Quiet Visits</p>
        <p class="mt-2 text-sm text-green-800 leading-relaxed">If you want to get hands-on with pandas — cleaning, feeding, preparing food — this is the only base near Chengdu that lets you do it.</p>
      </div>
      <div class="p-6 rounded-xl bg-amber-50 border border-amber-200">
        <p class="text-xs font-semibold text-amber-700 uppercase tracking-wide mb-1">Skip if</p>
        <p class="text-xl font-bold text-amber-900">You Want Lots of Pandas</p>
        <p class="mt-2 text-sm text-amber-800 leading-relaxed">With ~20 pandas vs Chengdu's 200, this is about quality over quantity. Go to <a href="/dujiangyan-vs-chengdu-panda-base" class="underline font-medium">Chengdu Research Base</a> for scale.</p>
      </div>
      <div class="p-6 rounded-xl bg-blue-50 border border-blue-200">
        <p class="text-xs font-semibold text-blue-700 uppercase tracking-wide mb-1">Ideal combo</p>
        <p class="text-xl font-bold text-blue-900">Volunteer Day + UNESCO Sites</p>
        <p class="mt-2 text-sm text-blue-800 leading-relaxed">Combine a morning volunteer shift with the <a href="/nearby-attractions" class="underline font-medium">Dujiangyan Irrigation System</a> and Mount Qingcheng — both UNESCO sites within 15 minutes.</p>
      </div>
    </div>
  </section>

  <!-- Why Dujiangyan -->
  <section class="max-w-7xl mx-auto px-4 py-24 md:py-32">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div>
        <SectionHeader
          eyebrow="Why Dujiangyan"
          title="A more personal panda experience"
          subtitle="Unlike the busy Chengdu Research Base, Dujiangyan Panda Base offers a tranquil setting where you can observe pandas in a natural hillside environment. The smaller crowds and closer viewing areas make every moment feel special."
        />
        <ul class="mt-8 space-y-4">
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-100 flex items-center justify-center mt-0.5 shrink-0">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-warm-700">Fewer visitors, more time to watch the pandas</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-100 flex items-center justify-center mt-0.5 shrink-0">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-warm-700">Hands-on volunteer program -- help care for pandas</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-100 flex items-center justify-center mt-0.5 shrink-0">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-warm-700">Set against the scenic hills of Dujiangyan, near the UNESCO irrigation system</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-accent-100 flex items-center justify-center mt-0.5 shrink-0">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent-600"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="text-warm-700">Easy day trip from Chengdu via high-speed train</span>
          </li>
        </ul>
      </div>
      <div class="relative">
        <img
          src="/images/panda-forest.webp"
          alt="Giant panda walking through a lush green forest"
          width="800"
          height="1000"
          class="rounded-2xl w-full aspect-[4/5] object-cover"
          loading="lazy"
        />
        <div class="absolute -bottom-4 -left-4 bg-accent-500 text-white rounded-xl px-5 py-3 shadow-lg">
          <p class="text-2xl font-bold">20+</p>
          <p class="text-xs text-accent-100">Pandas at the base</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost Overview -->
  <section class="bg-white py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeader
        eyebrow="At a Glance"
        title="What you will spend"
        subtitle="All costs in one place. No hidden fees, no surprises."
      />
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-5 rounded-xl border border-warm-200 bg-warm-50 text-center">
          <p class="text-xs font-medium text-warm-500 uppercase tracking-wide">General Visit</p>
          <p class="mt-2 text-3xl font-bold text-warm-900">¥58</p>
          <p class="text-xs text-warm-500 mt-1">Adult entrance</p>
          <p class="text-xs text-warm-400 mt-0.5">Students ¥29 · Seniors Free</p>
        </div>
        <div class="p-5 rounded-xl border border-accent-200 bg-accent-50 text-center ring-1 ring-accent-300">
          <p class="text-xs font-medium text-accent-700 uppercase tracking-wide">Volunteer Day</p>
          <p class="mt-2 text-3xl font-bold text-accent-800">¥700-900</p>
          <p class="text-xs text-accent-600 mt-1">Includes everything</p>
          <p class="text-xs text-accent-500 mt-0.5">Entry · Uniform · Lunch · Certificate</p>
        </div>
        <div class="p-5 rounded-xl border border-warm-200 bg-warm-50 text-center">
          <p class="text-xs font-medium text-warm-500 uppercase tracking-wide">Transport</p>
          <p class="mt-2 text-3xl font-bold text-warm-900">¥30-50</p>
          <p class="text-xs text-warm-500 mt-1">Round trip from Chengdu</p>
          <p class="text-xs text-warm-400 mt-0.5">Train ¥10-15 ×2 + Taxi ¥20-30</p>
        </div>
        <div class="p-5 rounded-xl border border-warm-200 bg-warm-50 text-center">
          <p class="text-xs font-medium text-warm-500 uppercase tracking-wide">Half-Day Trip</p>
          <p class="mt-2 text-3xl font-bold text-warm-900">¥88-108</p>
          <p class="text-xs text-warm-500 mt-1">Ticket + transport</p>
          <p class="text-xs text-warm-400 mt-0.5">Bring your own lunch</p>
        </div>
      </div>
      <p class="mt-4 text-center text-xs text-warm-500">Prices verified July 2026. <a href="/tickets" class="text-accent-600 hover:text-accent-700 underline">Full ticket breakdown →</a></p>
    </div>
  </section>

  <!-- Panda Daily Rhythm -->
  <section class="max-w-7xl mx-auto px-4 py-24 md:py-32">
    <SectionHeader
      eyebrow="During Your Visit"
      title="A panda's day — plan around it"
      subtitle="Pandas follow a predictable rhythm. Time your visit right and you will see them at their best."
    />
    <div class="mt-10 relative">
      <!-- Timeline line -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-warm-200 -translate-x-1/2 hidden md:block" />
      <div class="space-y-8">
        {[
          { time: "8:30 AM", emoji: "🌅", title: "Gates Open — Pandas Eat Breakfast", desc: "Best time of day. Pandas are hungry and active. You will see them climbing, playing, and munching bamboo. Arrive at opening.", active: true },
          { time: "9:00 AM", emoji: "🧹", title: "Volunteers Start Morning Shift", desc: "Volunteer program begins: safety briefing, change into uniform, head to enclosures to start cleaning and food prep.", active: false },
          { time: "10:30 AM", emoji: "🎋", title: "Feeding Time", desc: "Volunteers hand-feed pandas bamboo shoots, apples, and panda cakes under staff supervision. Best photo opportunity.", active: false },
          { time: "11:30 AM", emoji: "😴", title: "Nap Time Begins", desc: "Most pandas settle in for a midday nap. Good time to visit the museum, gift shop, or walk the nature trails.", active: false },
          { time: "12:00 PM", emoji: "🍱", title: "Lunch Break", desc: "Volunteers eat at the staff cafeteria. Regular visitors should bring their own food or plan to eat in Dujiangyan town.", active: false },
          { time: "2:00 PM", emoji: "🍎", title: "Afternoon Activity Window", desc: "Pandas wake up for an afternoon snack. Quieter than morning with softer light — great for photography.", active: true },
          { time: "3:30 PM", emoji: "📜", title: "Certificate & Wrap-Up", desc: "Volunteers receive their certificate and souvenir. Regular visitors make their final loop through the enclosures.", active: false },
          { time: "5:00 PM", emoji: "🌇", title: "Base Closes", desc: "Gates close. Head back to Chengdu or continue to the Dujiangyan Irrigation System (15 min away) for sunset views.", active: false },
        ].map((item) => (
          <div class="flex items-start gap-4 md:gap-8">
            <div class={`hidden md:flex w-1/2 justify-end ${item.active ? '' : 'md:order-2'}`}>
              {item.active && (
                <div class="text-right pr-8">
                  <span class="text-2xl">{item.emoji}</span>
                  <h3 class="text-base font-semibold text-accent-800">{item.title}</h3>
                  <p class="text-sm text-warm-600 mt-1 max-w-xs ml-auto">{item.desc}</p>
                </div>
              )}
            </div>
            <div class={`shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold z-10 ${item.active ? 'bg-accent-500 text-white ring-4 ring-accent-100' : 'bg-warm-200 text-warm-600'}`}>
              {item.time.split(':')[0]}
            </div>
            <div class={`md:w-1/2 ${item.active ? '' : 'md:order-1 md:text-right md:pr-8'}`}>
              <div class="md:hidden mb-1"><span class="text-lg">{item.emoji}</span></div>
              <p class="text-xs font-semibold text-warm-500">{item.time}</p>
              <h3 class={`text-sm font-semibold mt-0.5 ${item.active ? 'text-accent-800' : 'text-warm-700'}`}>{item.title}</h3>
              <p class="text-xs text-warm-600 mt-1 leading-relaxed md:max-w-xs">{item.desc}</p>
              {!item.active && <div class="hidden md:block mt-1"><span class="text-xl">{item.emoji}</span></div>}
            </div>
          </div>
        ))}
      </div>
    </div>
    <p class="mt-10 text-center text-xs text-warm-500">Based on typical daily schedule. Actual times may vary by season. <a href="/visit-guide" class="text-accent-600 hover:text-accent-700 underline">Full visit guide →</a></p>
  </section>

  <!-- Explore Sections -->
  <section class="bg-white py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-4">
      <SectionHeader
        eyebrow="Plan Your Visit"
        title="Everything you need to know"
        subtitle="From volunteer signups to getting there, we've covered every detail of your Dujiangyan panda adventure."
      />
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <ContentCard
          href="/volunteer-program"
          title="Volunteer Program"
          description="Spend a day as a panda keeper. Learn about costs, booking, age limits, and what a typical volunteer day looks like."
        />
        <ContentCard
          href="/tickets"
          title="Tickets & Pricing"
          description="Entrance fees, where to buy tickets, discount options, and tips for avoiding the queues."
        />
        <ContentCard
          href="/how-to-get-there"
          title="How to Get There"
          description="Step-by-step directions from Chengdu by train, bus, taxi, or organized tour. Maps and travel times included."
        />
        <ContentCard
          href="/dujiangyan-vs-chengdu-panda-base"
          title="Dujiangyan vs Chengdu"
          description="Compare the two bases side by side so you can decide which one fits your itinerary best."
        />
        <ContentCard
          href="/best-time-to-visit"
          title="Best Time to Visit"
          description="Season-by-season guide to weather, crowds, panda activity, and what to expect each month."
        />
        <ContentCard
          href="/nearby-attractions"
          title="Nearby Attractions"
          description="Combine your visit with the Dujiangyan Irrigation System, Mount Qingcheng, and other UNESCO sites nearby."
        />
      </div>
    </div>
  </section>

  <!-- Pre-Trip Checklist -->
  <section class="max-w-7xl mx-auto px-4 py-24 md:py-32">
    <SectionHeader
      eyebrow="Before You Go"
      title="Pack this, not that"
      subtitle="Six essentials that make the difference between a good visit and a great one."
    />
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {[
        { icon: "👟", title: "Comfortable walking shoes", desc: "The base is on a hillside with uneven paths. Leave the sandals at home.", must: true },
        { icon: "📷", title: "Camera with zoom lens", desc: "Pandas may be 5-15 meters away from viewing areas. Phone zoom won't cut it.", must: true },
        { icon: "🛂", title: "Passport", desc: "Required for foreign visitors at ticket purchase and entry. No exceptions.", must: true },
        { icon: "🧴", title: "Sunscreen + hat", desc: "Limited shade in some open areas. Sichuan sun is stronger than you think.", must: true },
        { icon: "💧", title: "Water + snacks", desc: "Limited food options inside the base. Pack enough for a half day.", must: false },
        { icon: "🌂", title: "Rain jacket or umbrella", desc: "Sichuan weather changes fast. A light rain jacket saves your day.", must: false },
      ].map((item) => (
        <div class={`p-5 rounded-xl border ${item.must ? 'border-accent-200 bg-accent-50/30' : 'border-warm-200'}`}>
          <div class="flex items-start gap-3">
            <span class="text-2xl shrink-0">{item.icon}</span>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="font-semibold text-sm text-warm-900">{item.title}</h3>
                {item.must && <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-accent-500 text-white font-semibold">MUST</span>}
              </div>
              <p class="text-xs text-warm-600 mt-1 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-accent-900 py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight">Ready to meet the pandas?</h2>
      <p class="mt-4 text-accent-200 max-w-lg mx-auto">Start planning your Dujiangyan panda adventure today. The pandas are waiting.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/visit-guide" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-accent-800 font-medium text-sm hover:bg-accent-50 transition-colors">
          Read the Full Guide
        </a>
        <a href="/volunteer-program" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-accent-400 text-white font-medium text-sm hover:bg-accent-800 transition-colors">
          Volunteer Program
        </a>
      </div>
    </div>
  </section>

  <!-- Share Your Story (Post-Visit) -->
  <section class="max-w-3xl mx-auto px-4 py-24 md:py-32 text-center">
    <SectionHeader
      eyebrow="After Your Visit"
      title="Been there? Share your story"
      subtitle="Your experience helps future visitors plan better trips. Send us your photos, tips, and panda stories — we feature the best ones on our blog."
    />
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent-500 text-white font-medium text-sm hover:bg-accent-600 transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13 2 4"/></svg>
        Share Your Experience
      </a>
      <a href="/blog" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-warm-300 text-warm-700 font-medium text-sm hover:bg-warm-50 transition-colors">
        Read Volunteer Stories
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 py-24 md:py-32">
    <SectionHeader
      eyebrow="FAQ"
      title="Frequently asked questions"
    />
    <div class="mt-10">
      <Faq items={faqItems} />
    </div>
  </section>
</BaseLayout>
