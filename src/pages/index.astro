<BaseLayout
  title="Dujiangyan Panda Base 2026: Tickets, Volunteer & Travel Guide"
  description="Complete Dujiangyan Panda Base guide: tickets, volunteer program, transport from Chengdu, best time to visit, vs Chengdu base & closure updates."
  jsonLd={combinedLd}
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-accent-950/80 via-accent-950/50 to-accent-950/30 z-10" />
    <div class="absolute inset-0">
      {heroSlides.map((slide, i) => (
        <img
          src={slide.src}
          alt={slide.alt}
          width="1920"
