  <script>
    document.documentElement.classList.add("js");

    document.querySelectorAll("select[data-anchor]").forEach((sel) => {
      sel.addEventListener("change", () => {
        if (sel.value) window.location.hash = sel.value;
      });
    });

    // ---------- Hero Ken Burns ----------
    const heroSlides = Array.from(document.querySelectorAll("[data-hero-slide]"));
    const heroDots = Array.from(document.querySelectorAll("[data-hero-dot]"));
    if (heroSlides.length > 1) {
      let current = 0;
      const show = (n) => {
        current = (n + heroSlides.length) % heroSlides.length;
        heroSlides.forEach((s, k) => {
          s.classList.toggle("opacity-0", k !== current);
          s.classList.toggle("hero-zoom", k === current);
        });
        heroDots.forEach((d, k) => {
          d.classList.toggle("bg-white", k === current);
          d.classList.toggle("bg-white/40", k !== current);
        });
      };
      heroDots.forEach((dot, k) => dot.addEventListener("click", () => show(k)));
      setInterval(() => show(current + 1), 7000);
    }

    // ---------- Scroll reveal ----------
    const revealEls = document.querySelectorAll(".reveal");
    if ("IntersectionObserver" in window) {
      const ro = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("reveal-in");
            ro.unobserve(e.target);
          }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      revealEls.forEach((el) => ro.observe(el));
    }

    // ---------- Count-up stats ----------
    const counters = document.querySelectorAll("[data-count]");
    const animateCount = (el) => {
      const to = parseFloat(el.dataset.count);
      const decimals = parseInt(el.dataset.decimals || "0", 10);
      const dur = 1500;
      const t0 = performance.now();
      const tick = (now) => {
        const p = Math.min((now - t0) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = (to * eased).toFixed(decimals);
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if (counters.length && "IntersectionObserver" in window) {
      const co = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const el = e.target;
            const decimals = parseInt(el.dataset.decimals || "0", 10);
            el.dataset.final = (parseFloat(el.dataset.count)).toFixed(decimals);
            animateCount(el);
            co.unobserve(el);
          }
        });
      }, { threshold: 0.5 });
      counters.forEach((c) => co.observe(c));
    }

    // ---------- Testimonial carousel ----------
    const trackEls = document.querySelectorAll("[data-testimonial]");
    if (trackEls.length > 1) {
      const track = document.querySelector("[data-testimonial-track]");
      const dots = Array.from(document.querySelectorAll("[data-testimonial-dot]"));
      const prev = document.querySelector("[data-testimonial-prev]");
      const next = document.querySelector("[data-testimonial-next]");
      let idx = 0;
      let timer;
      const go = (n) => {
        idx = (n + trackEls.length) % trackEls.length;
        track.style.transform = `translateX(-${idx * 100}%)`;
        dots.forEach((d, k) => d.classList.toggle("bg-accent-600", k === idx));
        dots.forEach((d, k) => d.classList.toggle("bg-warm-300", k !== idx));
      };
      const autoplay = () => { timer = setInterval(() => go(idx + 1), 6000); };
      dots.forEach((d, k) => d.addEventListener("click", () => { go(k); clearInterval(timer); autoplay(); }));
      prev && prev.addEventListener("click", () => { go(idx - 1); clearInterval(timer); autoplay(); });
      next && next.addEventListener("click", () => { go(idx + 1); clearInterval(timer); autoplay(); });
      autoplay();
    }
  </script>

