---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
---

<BaseLayout
  title="Nearby Attractions to Dujiangyan Panda Base - What to See"
  description="Discover attractions near Dujiangyan Panda Base: the UNESCO irrigation system, Mount Qingcheng, Panda Valley, Anlan Bridge, and other must-see sights."
>
  <section class="max-w-4xl mx-auto px-4 py-16 md:py-24">
    <p class="text-xs font-medium tracking-wide text-accent-600 uppercase mb-3">Nearby</p>
    <h1 class="text-3xl md:text-5xl font-bold text-warm-900 leading-tight tracking-tight">
      Nearby Attractions
    </h1>
    <p class="mt-4 text-lg text-warm-600 leading-relaxed max-w-2xl">
      Make a full day of it. Combine your panda visit with these incredible UNESCO sites and scenic spots just minutes away.
    </p>
    <p class="mt-2 text-xs text-warm-500">Last updated: July 2026</p>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-24 md:pb-32">
    <div class="space-y-12">
      {[
        {
          title: "Dujiangyan Irrigation System",
          dist: "15 min from Panda Base",
          unesco: true,
          image: "/images/dujiangyan-irrigation.webp",
          desc: "A 2,000-year-old engineering marvel and <a href=\"https://whc.unesco.org/en/list/1001\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent-600 hover:text-accent-700 underline\">UNESCO World Heritage site</a>. Built in 256 BC, this irrigation system still controls the waters of the Min River and made Sichuan the productive agricultural region it is today. Walk along the ancient riverbanks, cross the historic Anlan Suspension Bridge, and visit the stunning Erwang Temple dedicated to the system's builders Li Bing and his son.",
        },
        {
          title: "Mount Qingcheng",
          dist: "30 min from Panda Base",
          unesco: true,
          image: "/images/mount-qingcheng.webp",
          desc: "One of the birthplaces of Taoism and a <a href=\"https://whc.unesco.org/en/list/1001\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-accent-600 hover:text-accent-700 underline\">UNESCO World Heritage site</a> alongside the irrigation system. Hike through misty forests, visit ancient Taoist temples, and enjoy panoramic views from the summit. The front mountain (Qian Shan) is more developed with temples and cable cars, while the back mountain (Hou Shan) offers wilder scenery for serious hikers. Allow 3-5 hours for the front mountain.",
        },
        {
          title: "Panda Valley",
          dist: "20 min from Panda Base",
          unesco: false,
          image: null,
          desc: "Also known as the Dujiangyan Field Research Center for Giant Pandas, the Panda Valley (熊猫谷) is a semi-wild training area where pandas learn survival skills before potential release. It is less known than the main base and even quieter. A great add-on if you want to see pandas in a more natural, open setting.",
        },
        {
          title: "Anlan Bridge",
          dist: "20 min from Panda Base",
          unesco: false,
          image: null,
          desc: "A historic covered suspension bridge spanning the Min River, located within the Dujiangyan Irrigation System scenic area. First built in the Song Dynasty and rebuilt many times, the Anlan Bridge (also called the Couple's Bridge) offers great views of the rushing river below and the surrounding mountains. Free to cross with your irrigation system ticket.",
        },
        {
          title: "Dujiangyan Old Town",
          dist: "15 min from Panda Base",
          unesco: false,
          image: null,
          desc: "After a day of pandas and UNESCO sites, head to Dujiangyan's old town for dinner. The pedestrian streets near the South Bridge (Nanqiao) come alive at night with food stalls, riverside restaurants, and traditional Sichuan opera performances. Try local specialties like Dujiangyan smoked ribs and Sichuan-style hot pot. The illuminated South Bridge is particularly beautiful after dark.",
        },
      ].filter(a => a.image !== null || true).map((attraction) => (
        <div class={attraction.image ? "grid md:grid-cols-2 gap-8 items-center" : "p-6 rounded-xl border border-warm-200 bg-white"}>
          {attraction.image && <img src={attraction.image} alt={attraction.title} width="800" height="600" class="rounded-xl w-full aspect-[4/3] object-cover" loading="lazy" />}
          <div>
            <div class="flex items-center gap-2 mb-2">
              {attraction.unesco && <span class="text-xs font-medium px-2 py-0.5 rounded bg-amber-100 text-amber-700">UNESCO</span>}
              <span class="text-xs text-warm-500">{attraction.dist}</span>
            </div>
            <h3 class="text-xl font-semibold text-warm-900">{attraction.title}</h3>
            <p class="mt-3 text-sm text-warm-600 leading-relaxed" set:html={attraction.desc} />
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 p-6 rounded-xl bg-accent-50 border border-accent-200">
      <h2 class="font-semibold text-warm-900 mb-2">Suggested day-trip route</h2>
      <p class="text-sm text-warm-600 leading-relaxed">Start at the Panda Base in the morning (8:30 AM), then head to the Dujiangyan Irrigation System for the afternoon. Cross the Anlan Bridge, explore the temples, and finish with dinner in Dujiangyan Old Town. If you are hiking Mount Qingcheng, dedicate a separate full day — the mountain deserves it.</p>
    </div>
  </section>
</BaseLayout>
